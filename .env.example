# Nombre de la empresa o aplicación
APP_NAME="Kora Hair"

# Email de soporte / contacto
APP_EMAIL=contacto@ejemplo.com

# Entorno de ejecución: local | produccion
APP_ENV=local

# --- Base de datos MySQL (TP7) ---
# En XAMPP el usuario es "root" y la contraseña está vacía.
DB_HOST=localhost
DB_NAME=kora_hair
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
